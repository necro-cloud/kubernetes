# Controlling how many workers do we need
# for to be deployed in the K3s cluster
WORKER_NODES=3

# DO NOT SET ANY VALUES HERE
# K3S TOKEN IS GENERATED ON CLUSTER UP
K3S_TOKEN=

# Resource limits on the cluster
K3S_CPU_LIMIT=2.0
K3S_MEM_LIMIT=4G

# Resource reservations for the cluster
K3S_CPU_RESERVE=0.5
K3S_MEM_RESERVE=1G
